# ==========================================
# SprintPilot Environment Configuration
# ==========================================

# Active Spring Profile (dev or prod)
# 'dev' uses in-memory H2 with PostgreSQL syntax and pre-seeded realistic data
# 'prod' connects to an external PostgreSQL instance
SPRING_PROFILES_ACTIVE=dev

# Database Connection (Used when SPRING_PROFILES_ACTIVE=prod)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sprintpilot_db
SPRING_DATASOURCE_USERNAME=sprintpilot_user
SPRING_DATASOURCE_PASSWORD=sprintpilot_secret_password

# JWT Security Configuration
# Must be at least 256 bits (32 bytes) long for HMAC-SHA256
APP_JWT_SECRET=sprintpilotSuperSecretProductionKeyDoNotShareInPublicRepositoriesMinimum256BitsLongEnterpriseSecurity2026Key!
APP_JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Server Port
SERVER_PORT=8080

# Optional: OpenAI API Key for Live LLM User Story Generation
# Leave empty to use SprintPilot's robust offline heuristic NLP engine (100% demo uptime)
OPENAI_API_KEY=
